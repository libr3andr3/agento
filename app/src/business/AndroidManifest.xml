<?xml version="1.0" encoding="utf-8"?>
<!-- agento business: the receptionist. Reads chat-app notifications, replies
     as the business, detects payments. Distributed from agento.ceo / F-Droid
     only — the notification-listener + install permissions keep it off Play. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Coins hand to hand: classic Bluetooth RFCOMM, no pairing required. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <!-- Xiaomi/Huawei & friends kill background listeners; we ask the user to
         exempt agente so the notification listener survives. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- The notification listener already sees every app; this lets the
         Cobros screen check whether the wallet the owner named is installed
         on THIS phone (no fixed list of wallets exists anywhere). Not a Play
         build, so the permission is acceptable. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Android 11+ package visibility: Settings shows which supported chat
         apps are actually installed, which needs an explicit allowlist to
         query. Notification delivery itself never needed this. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.instagram.android" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.facebook.mlite" />
        <package android:name="com.facebook.katana" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.google.android.apps.messaging" />
    </queries>

    <application>
        <activity
            android:name=".WelcomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Step-by-step registration; portrait-locked like the chat so the
             step state machine never fights a rotation mid-request. -->
        <activity
            android:name=".RegistrationActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".DashboardActivity"
            android:exported="false" />

        <activity
            android:name=".PlanActivity"
            android:exported="false" />

        <activity
            android:name=".CrmListActivity"
            android:exported="false" />

        <activity
            android:name=".ConversationActivity"
            android:exported="false" />

        <activity
            android:name=".BackupUpsellActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".CoinsActivity"
            android:exported="false" />
        <activity
            android:name=".PayoutActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".AgenteNotificationListener"
            android:label="@string/app_name"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
