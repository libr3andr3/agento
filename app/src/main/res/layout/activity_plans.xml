<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/agento_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_m">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/plan_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="@color/agento_on_surface" />

        <!-- Where the account stands: plan and this month's conversations. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            app:cardBackgroundColor="@color/agento_primary_container"
            app:cardCornerRadius="@dimen/corner_card"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_m">

                <TextView
                    android:id="@+id/plan_current"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="@color/agento_on_primary_container" />

                <TextView
                    android:id="@+id/plan_usage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/agento_on_primary_container" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- The three plans (item_plan_tier.xml each). -->
        <LinearLayout
            android:id="@+id/plan_tiers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/plan_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/agento_on_surface_muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/plan_sales"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:minHeight="@dimen/cta_height"
            android:text="@string/plan_sales_cta" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/space_l"
            android:background="@color/agento_outline" />

        <TextView
            android:id="@+id/plan_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/agento_on_surface_muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/plan_logout"
            style="@style/Widget.Agento.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
            android:text="@string/account_manage_web"
            android:textColor="@color/agento_primary" />
    </LinearLayout>
</ScrollView>
