<?xml version="1.0" encoding="utf-8"?>
<!-- The moment after the interview: the owner just built something they
     would hate to lose. One screen, one promise, one button — bought on
     the web with the Yaya account (never in the app). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/agento_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/corner_card"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_earn_hero"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_yaya_alien"
                    app:tint="@color/agento_on_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/upsell_kicker"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="#B3FFFFFF" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/upsell_title"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textColor="@color/agento_on_primary" />

                <TextView
                    android:id="@+id/upsell_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="#E6FFFFFF" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/upsell_pitch"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/agento_on_surface" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="@dimen/space_xs" android:paddingBottom="@dimen/space_xs" android:text="@string/upsell_f1" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="@color/agento_on_surface" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="@dimen/space_xs" android:paddingBottom="@dimen/space_xs" android:text="@string/upsell_f2" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="@color/agento_on_surface" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="@dimen/space_xs" android:paddingBottom="@dimen/space_xs" android:text="@string/upsell_f3" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="@color/agento_on_surface" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="@dimen/space_xs" android:paddingBottom="@dimen/space_xs" android:text="@string/upsell_f4" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="@color/agento_on_surface" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/upsell_tiers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/upsell_cta"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cta_height"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/upsell_cta"
            app:icon="@drawable/ic_yaya_alien"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/space_s"
            app:iconSize="22dp"
            app:iconTint="@color/agento_on_primary" />

        <TextView
            android:id="@+id/upsell_web_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="@color/agento_on_surface_muted" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/upsell_later"
            style="@style/Widget.Agento.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/upsell_later" />
    </LinearLayout>
</ScrollView>
