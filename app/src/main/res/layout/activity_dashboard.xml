<?xml version="1.0" encoding="utf-8"?>
<!-- Owner's home. Pinned: header (name + status chip + switch + chat + gear)
     and the agent-off alert. Everything else scrolls under swipe-refresh:
     trial banner, earnings hero, Atención (gaps), agenda, pedidos, convos. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/agento_surface"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_l"
        android:paddingEnd="@dimen/space_s"
        android:paddingTop="@dimen/space_m">

        <TextView
            android:id="@+id/dash_business_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="@color/agento_on_surface" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/dash_agent_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
            android:contentDescription="@string/dash_agent_switch_desc" />

        <TextView
            android:id="@+id/dash_chat"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dash_talk_to_business"
            android:gravity="center"
            android:text="💬"
            android:textSize="22sp" />

        <ImageButton
            android:id="@+id/dash_settings"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dash_settings"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_gear" />
    </LinearLayout>

    <!-- Truth chip: is the agent answering right now? -->
    <com.google.android.material.chip.Chip
        android:id="@+id/dash_status"
        style="@style/Widget.Agento.Chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginEnd="@dimen/space_l"
        android:clickable="false"
        android:focusable="false"
        android:ellipsize="end"
        android:contentDescription="@string/dash_status_desc"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        app:chipStrokeWidth="0dp"
        app:ensureMinTouchTargetSize="false" />

    <!-- Agent-off alert: pinned so it can never scroll out of sight. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/off_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_marginEnd="@dimen/space_m"
        android:layout_marginTop="@dimen/space_s"
        android:visibility="gone"
        app:cardBackgroundColor="@color/agento_error_container"
        app:cardCornerRadius="@dimen/corner_card"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_m">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_off_banner"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/agento_error" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/off_banner_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:minHeight="@dimen/touch_min"
                android:text="@string/status_activate"
                android:textColor="@color/agento_on_primary"
                app:backgroundTint="@color/agento_error" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/dash_swipe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/space_s">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/space_m"
            android:paddingEnd="@dimen/space_m"
            android:paddingBottom="@dimen/space_l"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Update banner: a newer APK is published on agento.ceo. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/update_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_s"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/agento_secondary_container"
                    app:cardCornerRadius="@dimen/corner_card"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <TextView
                            android:id="@+id/update_banner_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/agento_on_secondary_container" />

                        <TextView
                            android:id="@+id/update_banner_notes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/agento_on_secondary_container" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/update_button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/touch_min"
                                android:text="@string/update_install" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/update_later_button"
                                style="@style/Widget.Agento.Button.Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_s"
                                android:minHeight="@dimen/touch_min"
                                android:text="@string/update_later" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Trial banner: secondary_container while active,
                     error_container once expired (bound in code). -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/trial_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_s"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/agento_secondary_container"
                    app:cardCornerRadius="@dimen/corner_card"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_m">

                        <TextView
                            android:id="@+id/trial_banner_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/trial_banner_text"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/agento_on_secondary_container" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/sales_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:minHeight="@dimen/touch_min"
                            android:text="@string/trial_talk_to_sales" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Earnings hero: hoy grande, semana/mes al costado. -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/corner_card"
                    app:cardElevation="@dimen/card_elevation"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_earn_hero"
                        android:padding="@dimen/space_l">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dash_today"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textColor="#B3FFFFFF" />

                            <TextView
                                android:id="@+id/earn_today"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:text="—"
                                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                                android:textColor="@color/agento_on_primary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dash_week"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:textColor="#8AFFFFFF" />

                            <TextView
                                android:id="@+id/earn_week"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="@color/agento_on_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_s"
                                android:text="@string/dash_month"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:textColor="#8AFFFFFF" />

                            <TextView
                                android:id="@+id/earn_month"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="@color/agento_on_primary" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Atención: questions the agent couldn't answer -->
                <TextView
                    android:id="@+id/gaps_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:layout_marginStart="@dimen/space_s"
                    android:text="@string/dash_attention"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/agento_secondary" />

                <LinearLayout
                    android:id="@+id/gaps_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_s" />

                <!-- Agenda -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:layout_marginStart="@dimen/space_s"
                    android:text="@string/dash_agenda"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/agento_on_surface" />

                <LinearLayout
                    android:id="@+id/agenda_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_xs" />

                <!-- Pedidos -->
                <TextView
                    android:id="@+id/orders_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:layout_marginStart="@dimen/space_s"
                    android:text="@string/dash_orders"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/agento_on_surface" />

                <LinearLayout
                    android:id="@+id/orders_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_s" />

                <!-- Conversaciones recientes -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:layout_marginStart="@dimen/space_s"
                    android:text="@string/dash_convos"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/agento_on_surface" />

                <LinearLayout
                    android:id="@+id/convos_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_s"
                    android:paddingBottom="@dimen/space_l" />
            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
