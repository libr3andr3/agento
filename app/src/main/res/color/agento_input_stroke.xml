<?xml version="1.0" encoding="utf-8"?>
<!-- Text field stroke: quiet hairline at rest, emerald when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/agento_primary" />
    <item android:state_enabled="false" android:color="@color/agento_surface_variant" />
    <item android:color="@color/agento_outline" />
</selector>
